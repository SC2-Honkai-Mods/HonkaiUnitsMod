<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
    <Frame type="CommandButton" name="ContainerButtonTemplate" template="CommandButton/CommandButtonTemplate">
        <TooltipAnchorPosition val="BottomToTop | HCenterToCenter"/>
        <TooltipFrame val="InventoryTooltip"/>
        <Width val="55"/>
        <Height val="55"/>
        <Frame type="Label" name="ChargeLabel">
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="-1"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-1"/>
            <Style val="RightJustified"/>
        </Frame>
    </Frame>
    <Frame type="InventoryContainer" name="ContainerPanel">
        <Frame type="Image" name="BackgroundImage">
            <Anchor side="Top" relative="$parent" pos="Min" offset="40"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <Texture val="@@UI/HotkeyBorder"/>
            <TextureType val="Border"/>
            <LayerColor val="##StandardBorderHotkey"/>
            <RenderPriority val="500"/>
        </Frame>
        <Frame type="Image" name="HeaderImage">
            <Anchor side="Top" relative="$parent" pos="Min" offset="15"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Width val="300"/>
            <Height val="64"/>
            <Texture val="@@UI/HotkeyBorderHeader"/>
            <TextureType val="EndCap"/>
            <LayerColor val="##StandardBorderHotkey"/>
            <RenderPriority val="500"/>
        </Frame>
        <Frame type="Label" name="Name" template="HotkeyDialog/HotkeyLabelLeftTemplate">
            <Anchor side="Top" relative="$parent/HeaderImage" pos="Min" offset="0"/>
            <Anchor side="Left" relative="$parent/HeaderImage" pos="Min" offset="8"/>
            <Anchor side="Right" relative="$parent/HeaderImage" pos="Max" offset="-18"/>
            <Style val="@@HotkeyDialogSectionHeader"/>
            <Options val="TooltipIfTruncated"/>
            <Height val="32"/>
        </Frame>
        <Frame type="CommandButton" name="Button">
            <Visible val="false"/>
        </Frame>
        <Frame type="Button" name="Close">
            <Visible val="false"/>
        </Frame>
        <Frame type="CommandButton" name="Slot00" template="InventoryMod/ContainerButtonTemplate">
            <Anchor side="Top" relative="$parent" pos="Min" offset="48"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="7"/>
        </Frame>
