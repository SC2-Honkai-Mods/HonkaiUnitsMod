                     <Frame type="CommandButton" name="Button02" template="InventoryMod/ContainerButtonTemplate"/>
                     <Frame type="CommandButton" name="Button03" template="InventoryMod/ContainerButtonTemplate"/>
                     <Frame type="CommandButton" name="Button04" template="InventoryMod/ContainerButtonTemplate"/>
                     <Frame type="CommandButton" name="Button05" template="InventoryMod/ContainerButtonTemplate"/>
                </Frame>
                <Frame type="InventoryContainer" name="ContainerPanel00" template="InventoryMod/ContainerPanel"/>
                <Frame type="InventoryContainer" name="ContainerPanel01" template="InventoryMod/ContainerPanel"/>
                <Frame type="InventoryContainer" name="ContainerPanel02" template="InventoryMod/ContainerPanel"/>
                <Frame type="InventoryContainer" name="ContainerPanel03" template="InventoryMod/ContainerPanel"/>
                <Frame type="InventoryContainer" name="ContainerPanel04" template="InventoryMod/ContainerPanel"/>
                <Frame type="InventoryContainer" name="ContainerPanel05" template="InventoryMod/ContainerPanel"/>
