    <Frame type="Frame" name="GameUI/UIContainer" file="GameUI">
        <Frame type="Frame" name="ConsoleUIContainer">
            <Frame type="InventoryPanel" name="InventoryPanel">
                 <Frame type="CommandTooltip" name="InventoryTooltip">
                     <Anchor side="Left" relative="$parent/InventoryTooltip" pos="Mid" offset="0"/>
                     <Anchor side="Right" relative="$parent/InventoryTooltip" pos="Mid" offset="0"/>
                 </Frame>
                 <Frame type="Image" name="Cursor">
                     <Width val="55"/>
                     <Height val="55"/>
                 </Frame>
                 <Frame type="InventoryContainer" name="InventoryButtons">
                     <Anchor side="Bottom" relative="$parent" pos="Max" offset="-265"/>
                     <Anchor side="Right" relative="$parent" pos="Max" offset="-245"/>
                     <Frame type="Frame" name="ContainerSizeFrame">
                         <Anchor side="Top" relative="$parent/Button00" pos="Min" offset="0"/>
                         <Anchor side="Bottom" relative="$parent/Button05" pos="Max" offset="0"/>
                         <Anchor side="Left" relative="$parent/Button00" pos="Min" offset="0"/>
                         <Anchor side="Right" relative="$parent/Button05" pos="Max" offset="0"/>
                     </Frame>
                     <Frame type="Image" name="BackgroundImage" template="StandardTemplates/StandardBorderTooltipGame">
                         <Anchor side="Top" relative="$parent" pos="Min" offset="-10"/>
                         <Anchor side="Bottom" relative="$parent" pos="Max" offset="10"/>
                         <Anchor side="Left" relative="$parent" pos="Min" offset="-10"/>
                         <Anchor side="Right" relative="$parent" pos="Max" offset="10"/>
